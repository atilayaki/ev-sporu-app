{
  "name": "evde-spor-mobile",
  "version": "1.0.0",
  "description": "Evde Spor - Kişisel Antrenör ve AI Fitness (Android & iOS Market Paketi)",
  "private": true,
  "scripts": {
    "cap:init": "npx cap add android && npx cap add ios",
    "cap:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "twa:init": "npx @bubblewrap/cli init --manifest=https://ev-sporu-app.vercel.app/manifest.json",
    "twa:build": "npx @bubblewrap/cli build"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0"
  }
}
